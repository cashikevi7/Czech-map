# PostgreSQL connection string (local dev via docker compose)
DATABASE_URL="postgresql://openmind:openmind@localhost:5433/openmind?schema=public"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Trust the host (required behind reverse proxies / Vercel / Docker)
AUTH_TRUST_HOST="true"
